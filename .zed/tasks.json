[
  {
    "label": "Start Metro Bundler",
    "command": "yarn start",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Start Metro (Reset Cache)",
    "command": "yarn reset",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Run Android",
    "command": "yarn android",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Run iOS",
    "command": "yarn ios",
